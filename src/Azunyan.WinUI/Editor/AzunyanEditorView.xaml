<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Azunyan.WinUI.AzunyanEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Azunyan.WinUI"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <UserControl.Resources>
        <MenuFlyout x:Name="EditorContextMenu" Opening="EditorContextMenu_Opening">
            <MenuFlyoutItem
                x:Name="CutContextMenuItem"
                Text="Cut"
                KeyboardAcceleratorTextOverride="Ctrl+X"
                Click="CutContextMenuItem_Click" />
            <MenuFlyoutItem
                x:Name="CopyContextMenuItem"
                Text="Copy"
                KeyboardAcceleratorTextOverride="Ctrl+C"
                Click="CopyContextMenuItem_Click" />
            <MenuFlyoutItem
                x:Name="PasteContextMenuItem"
                Text="Paste"
                KeyboardAcceleratorTextOverride="Ctrl+V"
                Click="PasteContextMenuItem_Click" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem
                x:Name="SelectAllContextMenuItem"
                Text="Select All"
                KeyboardAcceleratorTextOverride="Ctrl+A"
                Click="SelectAllContextMenuItem_Click" />
        </MenuFlyout>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="GutterColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Canvas
            x:Name="GutterCanvas"
            Grid.Column="0"
            IsHitTestVisible="False" />
        <canvas:CanvasControl
            x:Name="GutterDrawingSurface"
            Grid.Column="0"
            IsHitTestVisible="False" />
        <Grid
            x:Name="EditorHost"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ProjectedScrollBarColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Canvas
                x:Name="InputWindowLayer"
                Grid.Row="0"
                Grid.Column="0"
                IsHitTestVisible="False">
                <local:AzunyanTextInputWindow
                    x:Name="InputWindow"
                    Width="1"
                    Height="18"
                    Canvas.ZIndex="3"
                    IsHitTestVisible="True" />
            </Canvas>
            <Border
                x:Name="EditorPointerSurface"
                Grid.Row="0"
                Grid.Column="0"
                Background="Transparent"
                IsHitTestVisible="True" />
            <Grid
                x:Name="ProjectedSurfaceHost"
                Grid.Row="0"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False">
                <Canvas
                    x:Name="TextRenderLayer"
                    Canvas.ZIndex="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False" />
                <canvas:CanvasControl
                    x:Name="TextDrawingSurface"
                    Canvas.ZIndex="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False" />
                <Canvas
                    x:Name="RenderOverlay"
                    Canvas.ZIndex="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False" />
            </Grid>
            <ScrollBar
                x:Name="ProjectedVerticalScrollBar"
                Grid.Row="0"
                Grid.Column="1"
                Canvas.ZIndex="2"
                Width="18"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Orientation="Vertical"
                IndicatorMode="MouseIndicator"
                Visibility="Collapsed"
                IsTabStop="False" />
            <local:CompletionPopup
                x:Name="CompletionPopup"
                Width="1"
                Height="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top" />
            <Popup
                x:Name="TooltipPopup"
                IsHitTestVisible="False"
                IsOpen="False">
                <Border
                    x:Name="TooltipBorder"
                    MaxWidth="360"
                    Padding="10,7"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock
                            x:Name="TooltipTitle"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="TooltipContent"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
