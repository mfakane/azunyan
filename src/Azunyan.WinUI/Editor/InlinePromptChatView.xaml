<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Azunyan.WinUI.InlinePromptChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Azunyan.WinUI">
    <UserControl.Resources>
        <DataTemplate
            x:Key="InlinePromptChatEntryTemplate"
            x:DataType="local:InlinePromptChatEntry">
            <Border
                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Border
                        Background="{ThemeResource TextControlBackground}"
                        Visibility="{x:Bind UserStyleVisibility}" />
                    <Grid Padding="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            HorizontalAlignment="Right">
                            <Button
                                Content="Insert"
                                Padding="8,2"
                                IsEnabled="{x:Bind CanInsert}"
                                AutomationProperties.Name="Insert this entry into the editor selection"
                                ToolTipService.ToolTip="Replace the editor selection, or insert at the caret"
                                Click="InlinePromptInsertButton_Click" />
                            <Button
                                Content="Copy"
                                Padding="8,2"
                                AutomationProperties.Name="Copy this entry"
                                Click="InlinePromptCopyButton_Click" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind Text}"
                            Visibility="{x:Bind AssistantStyleVisibility}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            Text="{x:Bind Text}"
                            Visibility="{x:Bind UserStyleVisibility}"
                            Foreground="{ThemeResource TextControlForeground}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="InlinePromptBubbleRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            x:Name="InlinePromptBorder"
            Grid.Row="1"
            MaxWidth="680"
            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1,1,1,0"
            CornerRadius="4,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="4,4,0,0"
                    Padding="10,6,10,6">
                    <TextBlock x:Name="InlinePromptTitle" />
                </Border>
                <ScrollViewer
                    x:Name="InlinePromptTranscriptScrollViewer"
                     Grid.Row="1"
                     MaxHeight="180"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <ItemsControl
                        x:Name="InlinePromptTranscript"
                        ItemsSource="{x:Bind Entries, Mode=OneWay}"
                        ItemTemplate="{StaticResource InlinePromptChatEntryTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <Grid Grid.Row="2"
                      Margin="-1,-1,-1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:CompletionTextBox
                        x:Name="InlinePromptInput"
                        Grid.RowSpan="2"
                        Padding="10,6,10,34"
                        BorderThickness="0,1"
                        CornerRadius="0,0,4,4"
                        MinHeight="72"
                        MaxHeight="160"
                        IsEnabled="False"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextCompositionStarted="InlinePromptInput_TextCompositionStarted"
                        TextCompositionEnded="InlinePromptInput_TextCompositionEnded"
                        BeforeKeyDown="InlinePromptInput_BeforeKeyDown" />
                    <Grid Grid.Row="1"
                          Padding="10,0,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,1,0,0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            TextWrapping="Wrap"
                            Text="Enter to send · Shift+Enter for a new line" />
                        <Button
                            x:Name="InlinePromptCancelButton"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Padding="6,0"
                            Content="Cancel"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource SubtleButtonStyle}"
                            Click="InlinePromptCancelButton_Click" />
                        <Button
                            x:Name="InlinePromptSendButton"
                            Grid.Column="2"
                            Padding="0"
                            IsEnabled="False"
                            VerticalAlignment="Stretch"
                            AutomationProperties.Name="Send message"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="InlinePromptSendButton_Click">
                            <Button.Content>
                                <Grid Width="24" Height="24">
                                    <FontIcon
                                        x:Name="InlinePromptSendIcon"
                                        Glyph="&#xE74A;"
                                        Margin="1,0,0,0"
                                        FontSize="14"
                                        AutomationProperties.AccessibilityView="Raw" />
                                    <ProgressRing
                                        x:Name="InlinePromptBusyIndicator"
                                        Width="14"
                                        Height="14"
                                        IsActive="False"
                                        Visibility="Collapsed"
                                        AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </Button.Content>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Path
            x:Name="InlinePromptTopTailFill"
            Grid.Row="0"
            Width="18"
            Height="9"
            HorizontalAlignment="Left"
            Fill="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
            Data="M 0,9 L 9,0 L 18,9 Z" />
        <Path
            x:Name="InlinePromptTopTailOutline"
            Grid.Row="0"
            Width="18"
            Height="9"
            HorizontalAlignment="Left"
            Stroke="{ThemeResource SystemControlForegroundBaseLowBrush}"
            StrokeThickness="1"
            Data="M 0,9 L 9,0 L 18,9" />
        <Path
            x:Name="InlinePromptBottomTailFill"
            Grid.Row="2"
            Width="18"
            Height="9"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Fill="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
            Data="M 0,0 L 9,9 L 18,0 Z" />
        <Path
            x:Name="InlinePromptBottomTailOutline"
            Grid.Row="2"
            Width="18"
            Height="9"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Stroke="{ThemeResource SystemControlForegroundBaseLowBrush}"
            StrokeThickness="1"
            Data="M 0,0 L 9,9 L 18,0" />
    </Grid>
</UserControl>
