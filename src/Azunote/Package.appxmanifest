<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 uap5 uap10 desktop desktop2 desktop4 desktop6 rescap">

  <Identity
    Name="45929MFAlie.Azunote"
    Publisher="CN=D7E708B5-C0DE-4FEA-AC18-53FAA75BE2F5"
    Version="0.1.0.0" />

  <Properties>
    <DisplayName>Azunote</DisplayName>
    <PublisherDisplayName>MF Alie</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on"/>
    </uap10:PackageIntegrity>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <!--
      Subsystem="console" on the azu.exe alias requires this: the shell
      starts a client process per invocation, and Azunote keeps its own
      single-instance behaviour through its mutex and command pipe.
    -->
    <Application Id="azunote"
      Executable="$targetnametoken$.exe"
      EntryPoint="Windows.FullTrustApplication"
      desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="Azunote"
        Description="SDI style minimal code editor"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\MedTile.png"
        Square44x44Logo="Assets\AppList.png">
        <uap:DefaultTile Wide310x150Logo="Assets\WideTile.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation
            Name="textfiles"
            desktop2:AllowSilentDefaultTakeOver="true"
            MultiSelectModel="Single">
            <uap:DisplayName>Azunote text files</uap:DisplayName>
            <uap:Logo>Assets\FileAssociation.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="text/plain">.txt</uap:FileType>
              <uap:FileType ContentType="text/plain">.log</uap:FileType>
              <uap:FileType ContentType="text/plain">.json</uap:FileType>
              <uap:FileType ContentType="text/plain">.jsonc</uap:FileType>
              <uap:FileType ContentType="text/plain">.json5</uap:FileType>
              <uap:FileType ContentType="text/plain">.xml</uap:FileType>
              <uap:FileType ContentType="text/plain">.toml</uap:FileType>
              <uap:FileType ContentType="text/plain">.md</uap:FileType>
              <uap:FileType ContentType="text/plain">.yaml</uap:FileType>
              <uap:FileType ContentType="text/plain">.yml</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
        <!--
          Puts azu.exe on PATH. Subsystem="console" is what makes the shell
          wait for it and keep its standard output.
        -->
        <uap5:Extension
          Category="windows.appExecutionAlias"
          Executable="azu.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="azu.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
