<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Azunote</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <GenerateDisableRuntimeMarshallingAttribute>false</GenerateDisableRuntimeMarshallingAttribute>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <EnablePriGenTooling>false</EnablePriGenTooling>
    <EnableDefaultApplicationIcon>false</EnableDefaultApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnablePreviewMsixTooling>false</EnablePreviewMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Include="Application\App.xaml" />
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Page Remove="Application\App.xaml" />
    <EmbeddedResource Include="Resources\DefaultAppData\**\*"
                      LogicalName="Azunote.DefaultAppData.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinApp CLI integration: enables 'dotnet run' support for packaged apps -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
    <ProjectReference Include="..\Azunote.Ipc\Azunote.Ipc.csproj" />
    <!--
      azu.exe is the console entry point. The editor does not link against
      it, but it is built alongside and shipped next to Azunote.exe.
    -->
    <ProjectReference Include="..\Azunote.Cli\Azunote.Cli.csproj"
                     ReferenceOutputAssembly="false"
                     Private="false" />
    <ProjectReference Include="..\Azunyan.Core\Azunyan.Core.csproj" />
    <ProjectReference Include="..\Azunyan.Syntax\Azunyan.Syntax.csproj" />
    <ProjectReference Include="..\Azunyan.WinUI\Azunyan.WinUI.csproj" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="[1.4.0-azunyan.25680382dd21]" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321" PrivateAssets="all" />
    <!-- Windows App SDK: provides WinUI 3, app lifecycle, windowing, and other modern Windows APIs -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <AzunoteCliProject>$(MSBuildThisFileDirectory)..\Azunote.Cli\Azunote.Cli.csproj</AzunoteCliProject>
    <AzunoteCliOutputPath>$(MSBuildThisFileDirectory)..\Azunote.Cli\bin\$(Configuration)\net10.0\win-x64\</AzunoteCliOutputPath>
    <AzunoteCliPublishPath>$(AzunoteCliOutputPath)publish\</AzunoteCliPublishPath>
  </PropertyGroup>

  <!--
    Development builds take the client as built, which still needs the
    shared runtime. Publishing replaces it with the AOT-published single
    executable so that the package keeps its no-runtime-required property.
  -->
  <Target Name="BundleAzunoteCliForBuild" AfterTargets="Build"
          Condition="Exists('$(AzunoteCliOutputPath)azu.exe')">
    <ItemGroup>
      <_AzunoteCliBuildFiles Include="$(AzunoteCliOutputPath)azu.exe" />
      <_AzunoteCliBuildFiles Include="$(AzunoteCliOutputPath)azu.dll" />
      <_AzunoteCliBuildFiles Include="$(AzunoteCliOutputPath)azu.runtimeconfig.json" />
      <_AzunoteCliBuildFiles Include="$(AzunoteCliOutputPath)Azunote.Ipc.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_AzunoteCliBuildFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(_AzunoteCliBuildFiles.FullPath)')" />
  </Target>

  <Target Name="BundleAzunoteCliForPublish" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;$(AzunoteCliProject)&quot; -c $(Configuration) -r win-x64 --nologo" />
    <Copy SourceFiles="$(AzunoteCliPublishPath)azu.exe"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Native AOT currently leaves compiled XAML resources in the intermediate
    output instead of copying them to PublishDir. Application.LoadComponent
    needs the loose XBF files when the app is packaged.
  -->
  <Target Name="CopyXamlResourcesForAot" AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <_AzunoteAppXamlResources Include="$(OutputPath)**\*.xbf"
                                Exclude="$(PublishDir)**\*" />
      <_AzunoteReferencedXamlResources
          Include="$(MSBuildProjectDirectory)\..\Azunyan.WinUI\$(IntermediateOutputPath)embed\Azunyan.WinUI\**\*.xbf" />
      <_AzunoteXamlResources Include="$(OutputPath)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_AzunoteAppXamlResources)"
          DestinationFiles="@(_AzunoteAppXamlResources->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AzunoteReferencedXamlResources)"
          DestinationFiles="@(_AzunoteReferencedXamlResources->'$(PublishDir)Azunyan.WinUI\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AzunoteXamlResources)"
          DestinationFiles="@(_AzunoteXamlResources->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
