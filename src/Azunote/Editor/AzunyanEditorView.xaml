<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Azunote.AzunyanEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Azunote"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="GutterColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Canvas
            x:Name="GutterCanvas"
            Grid.Column="0"
            IsHitTestVisible="False" />
        <canvas:CanvasControl
            x:Name="GutterDrawingSurface"
            Grid.Column="0"
            IsHitTestVisible="False" />
        <Grid
            x:Name="EditorHost"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <local:AzunyanEditorControl
                x:Name="InputEditor"
                Grid.Row="0"
                Canvas.ZIndex="0"
                AllowDrop="True"
                AcceptsReturn="True"
                BorderThickness="0"
                Padding="8,6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Top"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextWrapping="NoWrap" />
            <Grid
                x:Name="ProjectedSurfaceHost"
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False">
                <Canvas
                    x:Name="TextRenderLayer"
                    Canvas.ZIndex="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False" />
                <canvas:CanvasControl
                    x:Name="TextDrawingSurface"
                    Canvas.ZIndex="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False" />
                <Canvas
                    x:Name="RenderOverlay"
                    Canvas.ZIndex="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    IsHitTestVisible="False" />
            </Grid>
            <ScrollBar
                x:Name="ProjectedVerticalScrollBar"
                Grid.Row="0"
                Canvas.ZIndex="2"
                Width="18"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Orientation="Vertical"
                Visibility="Collapsed"
                IsTabStop="False" />
            <Popup
                x:Name="CompletionPopup"
                IsLightDismissEnabled="False"
                IsOpen="False">
            <Border
                x:Name="CompletionBorder"
                Width="320"
                MaxHeight="240"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1">
                    <ListView
                        x:Name="CompletionList"
                        MaxHeight="238"
                        Background="Transparent"
                        Foreground="Transparent"
                        IsItemClickEnabled="True"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Text="{Binding Label}"
                                    Padding="8,4" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Popup>
            <Popup
                x:Name="TooltipPopup"
                IsHitTestVisible="False"
                IsOpen="False">
                <Border
                    x:Name="TooltipBorder"
                    MaxWidth="360"
                    Padding="10,7"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1">
                    <StackPanel>
                        <TextBlock
                            x:Name="TooltipTitle"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="TooltipContent"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
