<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-win2d" value="artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-win2d">
      <package pattern="Microsoft.Graphics.Win2D" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- Activated only by the submodule's own packageSources configuration. -->
    <packageSource key="Win2D-Dependencies">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
