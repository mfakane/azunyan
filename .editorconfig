root = true

[*]
end_of_line = crlf

[*.cs]
charset = utf-8
indent_style = space
indent_size = 4

[*.{csproj,props,targets}]
indent_style = space
indent_size = 2

[*.{json,xml}]
indent_style = space
indent_size = 2

# Test names intentionally use readable sentence-style underscores, and their
# expected-value arrays are test data rather than hot-path allocations.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
