{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build Azunote x64 Debug",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/Azunote/Azunote.csproj",
        "-c",
        "Debug",
        "-p:Platform=x64"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}